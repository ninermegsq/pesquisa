    "test": "npm --prefix current-site/osint-infoc-hacker run test",
    "dev": "npm --prefix current-site/osint-infoc-hacker run dev --",
    "dev:stop": "npm --prefix current-site/osint-infoc-hacker run dev:stop --",
    "dev:restart": "npm --prefix current-site/osint-infoc-hacker run dev:restart --",
