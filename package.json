    "preview": "npm --prefix current-site/osint-infoc-hacker run preview --",
    "warm-token": "npm --prefix current-site/osint-infoc-hacker run warm-token --",
    "probe:live": "npm --prefix current-site/osint-infoc-hacker run probe:live",
    "probe:novas": "npm --prefix current-site/osint-infoc-hacker run probe:novas",
    "probe:placa": "npm --prefix current-site/osint-infoc-hacker run probe:placa",
    "check:dev-preview": "npm --prefix current-site/osint-infoc-hacker run check:dev-preview",
    "check:dev-process": "npm --prefix current-site/osint-infoc-hacker run check:dev-process",
    "check:dev-ownership": "npm --prefix current-site/osint-infoc-hacker run check:dev-ownership",
    "check:stats": "npm --prefix current-site/osint-infoc-hacker run check:stats",
    "check:netlify": "npm --prefix osint-infoc-hacker run check",
    "check:build": "npm --prefix current-site/osint-infoc-hacker run check:build",
    "git": "git",
    "node": "node",
    "gh": "gh",
    "pesquisa:github": "npm --prefix current-site/osint-infoc-hacker run pesquisa:github --"
  },
  "dependencies": {},
  "devDependencies": {}
