{
  "name": "ostnt-osint",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "OSINT // infoc.hacker — repositorio com o site publicado (current-site) e o pacote Netlify alternativo (osint-infoc-hacker)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm --prefix current-site/osint-infoc-hacker run check && npm --prefix osint-infoc-hacker run check",
    "build": "npm --prefix current-site/osint-infoc-hacker run build",
    "test": "npm --prefix current-site/osint-infoc-hacker run test",
    "dev": "npm --prefix current-site/osint-infoc-hacker run dev --",
    "dev:stop": "npm --prefix current-site/osint-infoc-hacker run dev:stop --",
    "dev:restart": "npm --prefix current-site/osint-infoc-hacker run dev:restart --",
    "start": "npm --prefix current-site/osint-infoc-hacker run start --",
    "preview": "npm --prefix current-site/osint-infoc-hacker run preview --",
    "warm-token": "npm --prefix current-site/osint-infoc-hacker run warm-token --",
    "probe:live": "npm --prefix current-site/osint-infoc-hacker run probe:live",
    "check:netlify": "npm --prefix osint-infoc-hacker run check",
    "check:build": "npm --prefix current-site/osint-infoc-hacker run check:build",
    "git": "git",
    "gh": "gh"
  },
  "dependencies": {},
  "devDependencies": {}
}
